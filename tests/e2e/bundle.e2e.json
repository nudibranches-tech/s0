{
  "_note": "e2e policy bundle (the pushed policy data). open-user is scoped to the pub/ prefix of the 'open' bucket; admin-user has the whole tenant. This is what the platform would project and push in production; here it is a static fixture the gateway loads from bundle_path.",
  "org_settings": { "freeze_writes": false },
  "tenants": {
    "acme": {
      "user_attributes": {
        "open-user": { "groups": [], "attributes": [] },
        "admin-user": { "groups": [], "attributes": [] }
      },
      "bucket_attributes": {
        "open": { "denylist": {}, "sensitivity": "low" },
        "secret": { "denylist": {}, "sensitivity": "high" }
      },
      "s3_grants": {
        "open-user": [
          {
            "bucket": "open",
            "actions": ["read_objects", "list_objects", "write_objects", "delete_objects"],
            "prefixes": ["pub/"]
          }
        ],
        "admin-user": [
          { "bucket": "*", "actions": ["*"], "prefixes": [] }
        ]
      },
      "group_grants": {}
    }
  }
}
