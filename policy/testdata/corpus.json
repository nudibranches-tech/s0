{
  "_comment": "Golden decision corpus for policy/gateway/authz.rego. Engine-agnostic: replayed through BOTH regorus (fast path) and OPA (sidecar) by the dual-engine parity gate, and the seed of the conformance corpus. `expect` asserts allow + obligations; obligations.allowed_prefixes is compared order-insensitively.",
  "bundles": {
    "default": {
      "org_settings": { "freeze_writes": false },
      "tenants": {
        "acme": {
          "user_attributes": {
            "alice": { "groups": ["analysts"], "attributes": [] },
            "bob":   { "groups": [], "attributes": [] },
            "carol": { "groups": ["admins"], "attributes": [] },
            "dave":  { "groups": [], "attributes": [] },
            "mallory": { "groups": [], "attributes": [] }
          },
          "bucket_attributes": {
            "reports": { "denylist": { "bob": true }, "sensitivity": "high" },
            "public":  { "denylist": {}, "sensitivity": "low" }
          },
          "s3_grants": {
            "alice": [
              { "bucket": "reports", "actions": ["read_objects", "list_objects"], "prefixes": ["2024/", "2025/"] }
            ],
            "bob": [
              { "bucket": "public", "actions": ["read_objects", "list_objects", "write_objects"], "prefixes": [] }
            ],
            "carol": [
              { "bucket": "*", "actions": ["*"], "prefixes": [] }
            ],
            "dave": [
              { "bucket": "reports", "actions": ["read_objects", "list_objects"], "prefixes": ["logs/"] }
            ]
          },
          "group_grants": {
            "analysts": [
              { "bucket": "public", "actions": ["read_objects", "list_objects"], "prefixes": ["shared/"] }
            ],
            "admins": []
          }
        }
      }
    },
    "frozen": {
      "org_settings": { "freeze_writes": true },
      "tenants": {
        "acme": {
          "user_attributes": { "bob": { "groups": [], "attributes": [] } },
          "bucket_attributes": { "public": { "denylist": {} } },
          "s3_grants": {
            "bob": [
              { "bucket": "public", "actions": ["read_objects", "write_objects"], "prefixes": [] }
            ]
          },
          "group_grants": {}
        }
      }
    }
  },
  "cases": [
    { "name": "read within prefix grant", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"reports", "object":"2024/q1.csv", "request":{"method":"GET"} },
      "expect": { "allow": true, "reason_contains": "grant matched" } },

    { "name": "read outside prefix grant denied", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"reports", "object":"2023/old.csv", "request":{"method":"GET"} },
      "expect": { "allow": false, "reason_contains": "no grant" } },

    { "name": "write denied when grant lacks write action", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"write_objects", "bucket":"reports", "object":"2024/new.csv", "request":{"method":"PUT"} },
      "expect": { "allow": false } },

    { "name": "whole-bucket read grant", "bundle": "default",
      "input": { "principal": {"sub":"bob","type":"user","attributes":{"groups":[]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"public", "object":"anything/here.txt", "request":{"method":"GET"} },
      "expect": { "allow": true } },

    { "name": "denylist beats membership", "bundle": "default",
      "input": { "principal": {"sub":"bob","type":"user","attributes":{"groups":[]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"reports", "object":"2024/q1.csv", "request":{"method":"GET"} },
      "expect": { "allow": false, "reason_contains": "denylist" } },

    { "name": "whole-bucket write grant", "bundle": "default",
      "input": { "principal": {"sub":"bob","type":"user","attributes":{"groups":[]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"write_objects", "bucket":"public", "object":"upload/x.bin", "request":{"method":"PUT"} },
      "expect": { "allow": true } },

    { "name": "wildcard bucket and action delete", "bundle": "default",
      "input": { "principal": {"sub":"carol","type":"user","attributes":{"groups":["admins"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"delete_objects", "bucket":"reports", "object":"2024/q1.csv", "request":{"method":"DELETE"} },
      "expect": { "allow": true } },

    { "name": "non-member denied", "bundle": "default",
      "input": { "principal": {"sub":"eve","type":"user","attributes":{"groups":[]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"public", "object":"x.txt", "request":{"method":"GET"} },
      "expect": { "allow": false, "reason_contains": "not a tenant member" } },

    { "name": "group grant read within shared prefix", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"public", "object":"shared/report.csv", "request":{"method":"GET"} },
      "expect": { "allow": true } },

    { "name": "group grant does not cover other prefixes", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"public", "object":"private/secret.csv", "request":{"method":"GET"} },
      "expect": { "allow": false } },

    { "name": "token-claimed group is ignored; live bundle membership is authoritative", "bundle": "default",
      "input": { "principal": {"sub":"mallory","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"public", "object":"shared/report.csv", "request":{"method":"GET"} },
      "expect": { "allow": false, "reason_contains": "no grant" } },

    { "name": "list unbounded with multiple prefix grants -> allowed_prefixes", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"list_objects", "bucket":"reports", "request":{"method":"GET"} },
      "expect": { "allow": true, "allowed_prefixes": ["2024/", "2025/"] } },

    { "name": "list with in-scope prefix -> no narrowing", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"list_objects", "bucket":"reports", "prefix":"2024/", "request":{"method":"GET"} },
      "expect": { "allow": true, "no_obligations": true } },

    { "name": "list with out-of-scope prefix denied", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"list_objects", "bucket":"reports", "prefix":"other/", "request":{"method":"GET"} },
      "expect": { "allow": false } },

    { "name": "list unbounded with single prefix grant -> narrow_prefix", "bundle": "default",
      "input": { "principal": {"sub":"dave","type":"user","attributes":{"groups":[]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"list_objects", "bucket":"reports", "request":{"method":"GET"} },
      "expect": { "allow": true, "narrow_prefix": "logs/" } },

    { "name": "list whole-bucket grant -> no narrowing", "bundle": "default",
      "input": { "principal": {"sub":"bob","type":"user","attributes":{"groups":[]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"list_objects", "bucket":"public", "request":{"method":"GET"} },
      "expect": { "allow": true, "no_obligations": true } },

    { "name": "manage_lifecycle allowed by wildcard grant", "bundle": "default",
      "input": { "principal": {"sub":"carol","type":"user","attributes":{"groups":["admins"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"manage_lifecycle", "bucket":"reports", "request":{"method":"PUT"} },
      "expect": { "allow": true } },

    { "name": "manage_lifecycle denied without grant", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"manage_lifecycle", "bucket":"reports", "request":{"method":"PUT"} },
      "expect": { "allow": false } },

    { "name": "object read with MISSING key denies (no keyless whole-bucket fallthrough)", "bundle": "default",
      "input": { "principal": {"sub":"carol","type":"user","attributes":{"groups":["admins"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"reports", "request":{"method":"GET"} },
      "expect": { "allow": false } },

    { "name": "copy source read half allowed (carol)", "bundle": "default",
      "input": { "principal": {"sub":"carol","type":"user","attributes":{"groups":["admins"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"reports", "object":"2024/src.csv", "copy_source":{"bucket":"reports","key":"2024/src.csv"}, "request":{"method":"PUT"} },
      "expect": { "allow": true } },

    { "name": "copy dest write half denied for read-only principal (alice)", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"write_objects", "bucket":"reports", "object":"2024/dst.csv", "copy_source":{"bucket":"reports","key":"2024/src.csv"}, "request":{"method":"PUT"} },
      "expect": { "allow": false } },

    { "name": "multi-delete per-key allowed (carol, key A)", "bundle": "default",
      "input": { "principal": {"sub":"carol","type":"user","attributes":{"groups":["admins"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"delete_objects", "bucket":"reports", "object":"2024/a.csv", "request":{"method":"POST"} },
      "expect": { "allow": true } },

    { "name": "multi-delete per-key denied (alice, no delete grant)", "bundle": "default",
      "input": { "principal": {"sub":"alice","type":"user","attributes":{"groups":["analysts"]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"delete_objects", "bucket":"reports", "object":"2024/a.csv", "request":{"method":"POST"} },
      "expect": { "allow": false } },

    { "name": "write frozen by org kill-switch", "bundle": "frozen",
      "input": { "principal": {"sub":"bob","type":"user","attributes":{"groups":[]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"write_objects", "bucket":"public", "object":"x.bin", "request":{"method":"PUT"} },
      "expect": { "allow": false, "reason_contains": "frozen" } },

    { "name": "read still allowed while writes frozen", "bundle": "frozen",
      "input": { "principal": {"sub":"bob","type":"user","attributes":{"groups":[]}}, "backend":{"id":"bay-1","kind":"ceph"}, "tenant":"acme", "organization_id":"org-acme", "action":"read_objects", "bucket":"public", "object":"x.bin", "request":{"method":"GET"} },
      "expect": { "allow": true } }
  ]
}
